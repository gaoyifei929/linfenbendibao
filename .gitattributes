# 统一换行符：仓库统一存储 LF，检出到工作区也用 LF
# 避免 Windows/Linux 协作与 CI 中出现 CRLF 噪音 diff
* text=auto eol=lf

# 二进制文件：禁止任何行尾转换与文本 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# 锁文件按文本处理并在 diff 中隐藏（保持 eol=lf 归一）
pnpm-lock.yaml -diff

# 构建产物与依赖目录导出时不带 git 属性
dist/     export-ignore
node_modules/ export-ignore
